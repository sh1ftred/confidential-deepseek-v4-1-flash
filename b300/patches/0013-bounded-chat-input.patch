+    @model_validator(mode="after")
+    def _validate_bounded_input(self) -> "ChatCompletionRequest":
+        if self.max_input_tokens is None:
+            if "max_input_tokens" in self.model_fields_set:
+                raise VLLMValidationError(
+                    "max_input_tokens must be a positive integer.",
+                    parameter="max_input_tokens",
+                )
+            return self
+        unsupported = {
+            "n": self.n != 1,
+            "use_beam_search": self.use_beam_search,
+            "truncate_prompt_tokens": self.truncate_prompt_tokens is not None,
+            "kv_transfer_params": self.kv_transfer_params is not None,
+            "ec_transfer_params": self.ec_transfer_params is not None,
+            "vllm_xargs": self.vllm_xargs is not None,
+            "best_of": "best_of" in (self.model_extra or {}),
+            "prompt_embeds": "prompt_embeds" in (self.model_extra or {}),
+        }
+        for name, present in unsupported.items():
+            if present:
+                raise VLLMValidationError(
+                    "n must equal 1 with max_input_tokens."
+                    if name == "n"
+                    else f"{name} is incompatible with max_input_tokens.",
+                    parameter=name,
+                )
+        return self
